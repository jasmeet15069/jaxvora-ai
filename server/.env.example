DATABASE_URL=postgresql://user:password@host/dbname

# OpenCode Zen — default brain for all agents (model: north-mini-code-free)
OPENCODE_ZEN_API_KEY=sk-...
# Optional overrides:
# OPENCODE_ZEN_MODEL=north-mini-code-free
# OPENCODE_ZEN_BASE=https://opencode.ai/zen/v1
# OPENCODE_ZEN_PRIMARY=1
# LLM_PROVIDER_ORDER=zen,groq
# ORCHESTRATOR_PROVIDER=groq

# Failover providers
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

SECRET_KEY=your_random_secret_key
ENVIRONMENT=development
